KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/cit-nexus
KEYCLOAK_API_AUDIENCE=cit-nexus-api
KEYCLOAK_FRONTEND_CLIENT_ID=cit-nexus-frontend
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
KEYCLOAK_ROLE_CLAIM=realm_access.roles
DATABASE_URL=postgresql://cit_nexus:replace-me@localhost:5432/cit_nexus

# Server-side only. Put your Gemini API key in backend/.env; never in Vite config.
GEMINI_API_KEY=replace-with-server-side-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
