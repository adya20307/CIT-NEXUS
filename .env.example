# Copy to .env and replace every placeholder before starting local services.
KEYCLOAK_IMAGE=replace-with-a-pinned-supported-keycloak-image
KEYCLOAK_DB_USER=replace-with-local-db-user
KEYCLOAK_DB_PASSWORD=replace-with-a-strong-local-db-password
KC_BOOTSTRAP_ADMIN_USERNAME=replace-with-local-admin-name
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
